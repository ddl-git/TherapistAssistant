# Copia questo file in ".env" e compila i valori. Non committare mai ".env" reale.

# Chiave privata Flask per firmare le sessioni. Generane una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Hash della password unica di accesso all'app (NON la password in chiaro).
# Generalo con:
#   python -c "from werkzeug.security import generate_password_hash as g; print(g('la-tua-password'))"
APP_PASSWORD_HASH=

# Contenuto JSON completo della chiave della service account Google
# (l'intero contenuto del file .json scaricato da Google Cloud, su una riga).
# In locale puoi invece usare GOOGLE_SERVICE_ACCOUNT_FILE per puntare al file.
GOOGLE_SERVICE_ACCOUNT_JSON=

# In alternativa a GOOGLE_SERVICE_ACCOUNT_JSON: percorso locale al file .json della service account.
# Usalo solo in sviluppo locale, non su Render (niente disco persistente).
GOOGLE_SERVICE_ACCOUNT_FILE=

# ID del Google Sheet (dalla URL: https://docs.google.com/spreadsheets/d/QUESTO_ID/edit)
GOOGLE_SHEET_ID=

# ID del Google Calendar da cui leggere gli eventi (spesso è la tua email per il calendario principale)
GOOGLE_CALENDAR_ID=

# Parole chiave (separate da virgola) per escludere eventi non pazienti dalla coda,
# anche se contengono una parola nota del tariffario. Opzionale.
# ATTENZIONE: non usare qui una parola che è anche il nome di una piattaforma o
# tipo prestazione reale (es. "Privato"), altrimenti quegli eventi verranno
# sempre esclusi anche se pertinenti.
CALENDAR_IGNORE_KEYWORDS=Personale,Vacanza
